# 复制为 .env 后按需修改（.env 不会进 git）

# 自己的小红书昵称：通知里"回的是谁"会显示成"我"
XHS_MY_NICK=

# 关联号（user_id 或昵称，逗号分隔）：它们的评论/@ 会立刻写入唤醒日志
XHS_PRIORITY_USERS=

# 通知看门狗：0 关闭；唤醒日志路径；普通通知的叫醒时段
# XHS_WATCH=1
# XHS_WAKE_LOG=~/xhs-wake-events.log
# XHS_WATCH_HOURS=8-23

# 闲逛养号：0 关闭
# XHS_IDLE=1

# 通义千问（阿里云百炼）API 密钥（可选）：视频笔记的首选分析模型；不配则视频笔记直接走 Gemini 兜底
DASHSCOPE_API_KEY=your_api_key_here
# 千问思考模式：默认 0（关，更快更便宜）；1 打开（更慢更贵，见 README「视频笔记」）
# XHS_VIDEO_THINKING=0

# Gemini API 密钥（可选，笔记配图超过 4 张时使用；也是视频笔记的兜底）
# 免费申请：https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
